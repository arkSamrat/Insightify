<!DOCTYPE html>
<html>
<head>
  <title>Travel Lead Prediction</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 py-10">
  <div class="max-w-xl mx-auto bg-white p-8 rounded shadow">
    <h2 class="text-2xl font-bold mb-6 text-center">Travel Lead Prediction Form</h2>
    <form action="/predict" method="POST" class="space-y-4">

      
      <div>
        <label class="block text-gray-700 font-semibold">Age</label>
        <input type="number" name="Age" class="w-full border rounded px-3 py-2 mt-1" required />
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">TypeofContact</label>
        <select name="TypeofContact" class="w-full border rounded px-3 py-2 mt-1" required>
          <option value="Self Enquiry">Self Enquiry</option>
          <option value="Company Invited">Company Invited</option>
        </select>
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">CityTier</label>
        <select name="CityTier" class="w-full border rounded px-3 py-2 mt-1" required>
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
        </select>
      </div>


      <div>
        <label class="block text-gray-700 font-semibold">DurationOfPitch</label>
        <input type="number" name="DurationOfPitch" class="w-full border rounded px-3 py-2 mt-1" required />
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">Occupation</label>
        <select name="Occupation" class="w-full border rounded px-3 py-2 mt-1" required>
          <option value="Salaried">Salaried</option>
          <option value="Small Business">Small Business</option>
          <option value="Large Business">Large Business</option>
          <option value="Free Lancer">Free Lancer</option>
        </select>
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">Gender</label>
        <select name="Gender" class="w-full border rounded px-3 py-2 mt-1" required>
          <option value="Male">Male</option>
          <option value="Female">Female</option>
        </select>
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">NumberOfPersonVisiting</label>
        <input type="number" name="NumberOfPersonVisiting" class="w-full border rounded px-3 py-2 mt-1" required />
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">NumberOfFollowups</label>
        <input type="number" name="NumberOfFollowups" class="w-full border rounded px-3 py-2 mt-1" required />
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">ProductPitched</label>
        <select name="ProductPitched" class="w-full border rounded px-3 py-2 mt-1" required>
          <option value="Basic">Basic</option>
          <option value="Deluxe">Deluxe</option>
          <option value="Super Deluxe">Super Deluxe</option>
          <option value="King">King</option>
          <option value="Standard">Standard</option>
        </select>
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">PreferredPropertyStar</label>
        <input type="number" name="PreferredPropertyStar" class="w-full border rounded px-3 py-2 mt-1" required />
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">MaritalStatus</label>
        <select name="MaritalStatus" class="w-full border rounded px-3 py-2 mt-1" required>
          <option value="Single">Single</option>
          <option value="Married">Married</option>
          <option value="Divorced">Divorced</option>
        </select>
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">NumberOfTrips</label>
        <input type="number" name="NumberOfTrips" class="w-full border rounded px-3 py-2 mt-1" required />
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">Passport</label>
        <select name="Passport" class="w-full border rounded px-3 py-2 mt-1" required>
          <option value="0">No</option>
          <option value="1">Yes</option>
        </select>
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">PitchSatisfactionScore</label>
        <input type="number" name="PitchSatisfactionScore" class="w-full border rounded px-3 py-2 mt-1" required />
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">OwnCar</label>
        <select name="OwnCar" class="w-full border rounded px-3 py-2 mt-1" required>
          <option value="0">No</option>
          <option value="1">Yes</option>
        </select>
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">Designation</label>
        <select name="Designation" class="w-full border rounded px-3 py-2 mt-1" required>
          <option value="Executive">Executive</option>
          <option value="Manager">Manager</option>
          <option value="Senior Manager">Senior Manager</option>
          <option value="AVP">AVP</option>
          <option value="VP">VP</option>
        </select>
      </div>

      
      <div>
        <label class="block text-gray-700 font-semibold">MonthlyIncome</label>
        <input type="number" name="MonthlyIncome" class="w-full border rounded px-3 py-2 mt-1" required />
      </div>

      <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 w-full">Predict</button>
    </form>
  </div>
</body>
</html>
