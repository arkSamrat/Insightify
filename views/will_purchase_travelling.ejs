<!DOCTYPE html>
<html>
<head>
  <title>Prediction Result</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 py-10">
  <div class="max-w-xl mx-auto bg-white p-8 rounded shadow text-center">
    <h2 class="text-2xl font-bold mb-6 text-green-700">Prediction Result</h2>
    <p class="text-lg font-semibold text-gray-800"><%= prediction==1?'Yes, will take the travel plan':'NO, will Not the travel plan' %></p>
    <a href="/" class="mt-6 inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Back</a>
  </div>
</body>
</html>
