<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard | Insightify</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet"/>
</head>

<body class="bg-gradient-to-r from-green-100 via-blue-100 to-purple-100 font-sans min-h-screen">

  <!-- Navbar -->
  <header class="bg-white shadow-md p-4 sticky top-0 z-50 flex justify-between items-center">
    <h1 class="text-2xl font-bold text-green-600">
      Insightify
    </h1>

    <nav class="space-x-6">
      <a href="/home" class="text-gray-700 hover:text-green-500">Home</a>
      <a href="/dashboard" class="text-gray-700 hover:text-green-500">Dashboard</a>
      <a href="/logout" class="bg-green-500 hover:bg-green-600 text-white py-2 px-4 rounded-md">
        Logout
      </a>
    </nav>
  </header>


  <div class="flex flex-col md:flex-row">

    <!-- Sidebar -->
    <aside class="bg-white w-full md:w-1/5 p-6 shadow-md">
      <ul class="space-y-5">

        <li>
          <a href="/home" class="text-green-700 font-bold">
            Dashboard Overview
          </a>
        </li>

        <li>
          <a href="/Evaluation" class="text-gray-700 hover:text-green-600">
            🛒 Purchase / Travel Predictor
          </a>
        </li>

        <li>
          <a href="/Disease_predictor" class="text-gray-700 hover:text-green-600">
            🩺 Disease Predictor
          </a>
        </li>

        <li>
          <a href="/medicine_predictor" class="text-gray-700 hover:text-green-600">
            💊 Medicine Predictor
          </a>
        </li>

        <li>
          <a href="/crowd_predictor" class="text-gray-700 hover:text-green-600">
            👥 Crowd Predictor
          </a>
        </li>

      </ul>
    </aside>


    
    <main class="flex-1 p-8 bg-gradient-to-br from-white to-green-50">

     
      <section class="mb-10">
        <h2 class="text-4xl font-bold text-gray-800 mb-3">
          Welcome to Insightify 🚀
        </h2>
        <p class="text-lg text-gray-600">
          Smart predictions powered by Machine Learning.
        </p>
      </section>


      
      <section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">

        <div class="bg-green-100 p-6 rounded-xl shadow">
          <h3 class="text-lg font-semibold text-green-800">
            Total Predictions
          </h3>
          <p class="text-3xl font-bold mt-2">0</p>
        </div>

        <div class="bg-blue-100 p-6 rounded-xl shadow">
          <h3 class="text-lg font-semibold text-blue-800">
            Models Active
          </h3>
          <p class="text-3xl font-bold mt-2">4</p>
        </div>

        <div class="bg-purple-100 p-6 rounded-xl shadow">
          <h3 class="text-lg font-semibold text-purple-800">
            Accuracy
          </h3>
          <p class="text-3xl font-bold mt-2">95%</p>
        </div>

        <div class="bg-red-100 p-6 rounded-xl shadow">
          <h3 class="text-lg font-semibold text-red-800">
            API Status
          </h3>
          <p class="text-3xl font-bold mt-2">Live</p>
        </div>

      </section>


      
      <section>
        <h3 class="text-3xl font-bold text-green-700 mb-8">
          Available AI Services
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

          <a href="/Evaluation"
             class="bg-white p-8 rounded-2xl shadow hover:scale-105 transition text-center">
            <div class="text-5xl mb-4">🛒</div>
            <h4 class="font-bold text-lg">Purchase / Travel</h4>
            <p class="text-gray-500 mt-2">Predict customer buying behavior</p>
          </a>

          <a href="/medicine_predictor"
             class="bg-white p-8 rounded-2xl shadow hover:scale-105 transition text-center">
            <div class="text-5xl mb-4">💊</div>
            <h4 class="font-bold text-lg">Medicine Predictor</h4>
            <p class="text-gray-500 mt-2">Recommend medicine intelligently</p>
          </a>

          <a href="/Disease_predictor"
             class="bg-white p-8 rounded-2xl shadow hover:scale-105 transition text-center">
            <div class="text-5xl mb-4">🩺</div>
            <h4 class="font-bold text-lg">Disease Predictor</h4>
            <p class="text-gray-500 mt-2">Predict diseases from symptoms</p>
          </a>

          <a href="/crowd_predictor"
             class="bg-white p-8 rounded-2xl shadow hover:scale-105 transition text-center">
            <div class="text-5xl mb-4">👥</div>
            <h4 class="font-bold text-lg">Crowd Predictor</h4>
            <p class="text-gray-500 mt-2">Forecast crowd using date & location</p>
          </a>

        </div>
      </section>

    </main>
  </div>


 

</body>
</html>