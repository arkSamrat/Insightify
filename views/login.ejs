<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login | Insightify</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet"/>
</head>
<body class="bg-gradient-to-r from-green-100 via-blue-100 to-purple-100 font-sans">

  <header class="bg-white shadow-md p-6 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <h1 class="text-2xl font-bold text-green-600">Insightify</h1>
      <nav class="space-x-6">
        <a href="/home" class="text-gray-700 hover:text-green-500">Home</a>
        <a href="#features" class="text-gray-700 hover:text-green-500">Features</a>
        <a href="#about" class="text-gray-700 hover:text-green-500">About</a>
        <a href="#contact" class="text-gray-700 hover:text-green-500">Contact</a>
      </nav>
    </div>
  </header>

  <section class="min-h-screen flex items-center justify-center py-20">
    <div class="bg-white shadow-xl rounded-lg p-10 w-full max-w-md">
      <h2 class="text-3xl font-bold text-green-700 text-center mb-6">Company Login</h2>
      <form action="/login" method="POST" class="space-y-5">
        <div>
          <label for="email" class="block mb-1 font-medium text-gray-700">Email</label>
          <input type="email" id="email" name="email" required class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-green-300"/>
        </div>
        <div>
          <label for="password" class="block mb-1 font-medium text-gray-700">Password</label>
          <input type="password" id="password" name="password" required class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-green-300"/>
        </div>
        <div class="text-center">
          <button type="submit" class="bg-green-500 text-white px-6 py-3 rounded-md hover:bg-green-600 transition-all">
            Login
          </button>
        </div>
      </form>
      <p class="mt-4 text-sm text-gray-600 text-center">
        Don't have an account? <a href="/register" class="text-green-600 hover:underline">Register here</a>
      </p>
    </div>
  </section>

  <footer class="bg-white py-6 border-t text-center text-sm text-gray-500">
    &copy; 2025 Insightify. All rights reserved.
  </footer>
</body>
</html>
