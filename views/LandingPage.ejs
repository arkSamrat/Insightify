<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Insightify Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gradient-to-r from-green-100 via-blue-100 to-purple-100 font-sans">


  <header class="bg-white shadow-md p-6 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <h1 class="text-2xl font-bold text-green-600">Insightify</h1>

      <nav class="space-x-6">
        <a href="/home" class="text-gray-700 hover:text-green-500">Home</a>
        <a href="#services" class="text-gray-700 hover:text-green-500">Services</a>
        <a href="/login" class="text-gray-700 hover:text-green-500">Login</a>
        <a href="/register" class="bg-green-500 hover:bg-green-600 text-white py-2 px-4 rounded-md">
          Register
        </a>
      </nav>
    </div>
  </header>

 
  <section class="text-center py-20 bg-gradient-to-b from-white to-green-50">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-5xl font-bold text-gray-800 mb-5">
        AI Prediction Dashboard
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        Select an AI service and get instant smart predictions powered by Machine Learning.
      </p>
    </div>
  </section>

  
  <section id="services" class="py-20">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

      
      <div class="bg-white rounded-2xl shadow-lg p-8 text-center hover:scale-105 transition">
        <div class="text-5xl mb-4">🛒</div>
        <h3 class="text-xl font-bold text-green-700 mb-3">
          Purchase / Travel
        </h3>
        <p class="text-gray-600 mb-6">
          Predict whether a customer will purchase or travel.
        </p>
        <a href="/will_purchase_trevelling"
           class="bg-green-500 text-white px-6 py-2 rounded-lg hover:bg-green-600">
          Open
        </a>
      </div>

      <!-- Medicine -->
      <div class="bg-white rounded-2xl shadow-lg p-8 text-center hover:scale-105 transition">
        <div class="text-5xl mb-4">💊</div>
        <h3 class="text-xl font-bold text-blue-700 mb-3">
          Medicine Predictor
        </h3>
        <p class="text-gray-600 mb-6">
          Predict the best medicine based on symptoms.
        </p>
        <a href="/medicine_prediction"
           class="bg-blue-500 text-white px-6 py-2 rounded-lg hover:bg-blue-600">
          Open
        </a>
      </div>

      <!-- Disease -->
      <div class="bg-white rounded-2xl shadow-lg p-8 text-center hover:scale-105 transition">
        <div class="text-5xl mb-4">🩺</div>
        <h3 class="text-xl font-bold text-purple-700 mb-3">
          Disease Predictor
        </h3>
        <p class="text-gray-600 mb-6">
          Detect possible diseases from given symptoms.
        </p>
        <a href="/disease_predictor"
           class="bg-purple-500 text-white px-6 py-2 rounded-lg hover:bg-purple-600">
          Open
        </a>
      </div>

      <!-- Crowd -->
      <div class="bg-white rounded-2xl shadow-lg p-8 text-center hover:scale-105 transition">
        <div class="text-5xl mb-4">👥</div>
        <h3 class="text-xl font-bold text-red-700 mb-3">
          Crowd Predictor
        </h3>
        <p class="text-gray-600 mb-6">
          Predict crowd levels using date, time and location.
        </p>
        <a href="/crowd_predictor"
           class="bg-red-500 text-white px-6 py-2 rounded-lg hover:bg-red-600">
          Open
        </a>
      </div>

    </div>
  </section>

</body>
</html>