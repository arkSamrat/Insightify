<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ALGNITION</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gradient-to-r from-green-100 via-blue-100 to-purple-100 font-sans">
  <header class="bg-white shadow-md p-6 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <h1 class="text-2xl font-bold text-green-600">ALGNITION</h1>
      <nav class="space-x-6">
        <a href="/home" class="text-gray-700 hover:text-green-500">Home</a>
        <a href="#features" class="text-gray-700 hover:text-green-500">Features</a>
        <a href="#about" class="text-gray-700 hover:text-green-500">About</a>
        <a href="/contact" class="text-gray-700 hover:text-green-500">Contact</a>
        <a href="/register" class="bg-green-500 hover:bg-green-600 text-white py-2 px-4 rounded-md">Get Started</a>
      </nav>
    </div>
  </header>

  <section class="text-center py-20 bg-gradient-to-b from-white to-green-50">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-4xl font-bold text-gray-800 mb-4">Accelerate Your Startup's Growth with AI</h2>
      <p class="text-gray-600 text-lg mb-8">Upload your business data and receive actionable insights to boost your sales, productivity, and income using advanced Machine Learning and Deep Learning techniques.</p>
      <a href="/register" class="bg-green-500 text-white py-3 px-6 rounded-lg shadow-lg hover:bg-green-600 transition-all">Start Your Journey</a>
    </div>
  </section>

  <section id="features" class="py-20 bg-white">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div class="p-6 bg-green-100 rounded-xl shadow hover:shadow-lg transition">
        <h3 class="text-xl font-semibold text-green-800 mb-2">Easy Data Upload</h3>
        <p class="text-gray-700">Just fill in a form or upload a file – no technical skills needed.</p>
      </div>
      <div class="p-6 bg-blue-100 rounded-xl shadow hover:shadow-lg transition">
        <h3 class="text-xl font-semibold text-blue-800 mb-2">ML-Powered Insights</h3>
        <p class="text-gray-700">Our algorithms analyze trends, forecast sales, and recommend strategies.</p>
      </div>
      <div class="p-6 bg-purple-100 rounded-xl shadow hover:shadow-lg transition">
        <h3 class="text-xl font-semibold text-purple-800 mb-2">Personalized Reports</h3>
        <p class="text-gray-700">Receive clear, actionable recommendations to grow smarter.</p>
      </div>
    </div>
  </section>

  <section id="about" class="py-20 bg-gray-50 text-center">
    <h2 class="text-3xl font-bold mb-6">Why StartSmart AI?</h2>
    <p class="max-w-3xl mx-auto text-gray-600 text-lg">We're on a mission to empower small businesses with the power of data. Whether you're a bakery or a digital service startup, StartSmart AI helps you understand your business and improve it using the smartest tools available.</p>
  </section>

  <section id="contact" class="py-16 bg-green-50 text-center">
    <h2 class="text-2xl font-bold mb-4">Let’s Connect</h2>
    <p class="text-gray-600 mb-6">Have questions or feedback? Reach out to us anytime!</p>
    <a href="mailto:support@startsmart.ai" class="text-green-700 hover:underline">support@startsmart.ai</a>
  </section>

  <footer class="bg-white py-6 border-t text-center text-sm text-gray-500">
    &copy; 2025 StartSmart AI. All rights reserved.
  </footer>
</body>
</html>
