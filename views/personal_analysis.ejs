<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Analyzed Data | ALGNITION</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet"/>
</head>
<body class="bg-gray-50 text-gray-900">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-6 text-green-700">Analyzed Data</h1>
    

    <div class="bg-gradient-to-r from-green-100 via-white to-green-50 p-6 rounded-2xl shadow-xl border border-green-200 max-w-2xl mx-auto my-12">
  <div class="text-center">
    <h2 class="text-2xl md:text-3xl font-bold text-green-800 mb-2">🌟 Coming Soon to Algnition!</h2>
    <p class="text-gray-700 text-lg md:text-xl leading-relaxed">
      A groundbreaking feature is on the horizon — tailored insights and personalized growth paths for your startup.
    </p>
    <p class="text-green-700 font-medium mt-4">
      Stay tuned — innovation is just getting started.
    </p>
    <div class="mt-6">
      <span class="inline-block bg-green-100 text-green-800 px-4 py-2 rounded-full font-semibold text-sm tracking-wide shadow-sm">
        #EmpowerYourStartup
      </span>
    </div>
  </div>
</div>



    <% if (analysisResults && analysisResults.length > 0) { %>
      <div class="grid md:grid-cols-2 gap-6">
        <% analysisResults.forEach(item => { %>
          <div class="bg-white shadow-md rounded-2xl p-6 border border-green-100 hover:shadow-lg transition">
            <h2 class="text-xl font-semibold text-green-600 mb-2"><%= item.metricTitle %></h2>
            <p class="text-gray-600 mb-1">Value: <span class="font-medium text-black"><%= item.metricValue %></span></p>
            <% if (item.description) { %>
              <p class="text-sm text-gray-500 mt-1"><%= item.description %></p>
            <% } %>
            <% if (item.suggestion) { %>
              <p class="text-sm text-blue-600 mt-2 italic">🔍 Insight: <%= item.suggestion %></p>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="text-gray-500 text-center mt-12">No analyzed data available yet. Please input your startup details.</p>
    <% } %>

    <div class="mt-10 text-center">
      <a href="/dashboard" class="text-green-700 hover:underline text-sm">← Back to Dashboard</a>
    </div>
  </div>
</body>
</html>
